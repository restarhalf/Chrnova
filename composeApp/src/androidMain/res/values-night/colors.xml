<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 夜间版：底色压暗，行用略亮的卡片色，状态色保留可辨识度 -->
    <color name="widget_bg">#FF1C1C1E</color>
    <color name="widget_bg_small">#FF1C1C1E</color>
    <color name="widget_divider">#FF2C2C2E</color>
    <color name="widget_header_text">#B3FFFFFF</color>
    <color name="widget_empty_text">#B3FFFFFF</color>
    <color name="widget_time_text">#B3FFFFFF</color>
    <color name="widget_time_sub_text">#66FFFFFF</color>
    <color name="widget_title_text">#E6FFFFFF</color>
    <color name="widget_subtitle_text">#66FFFFFF</color>
    <color name="widget_subtle_text">#66FFFFFF</color>
    <color name="widget_dot">#FF6F97FF</color>
    <color name="widget_status_ongoing">#FF89C4FF</color>
    <color name="widget_status_upcoming">#FFFF8EA0</color>
    <color name="widget_status_done">#FF919BAA</color>
    <color name="widget_bar_default">#FF5F89FF</color>
    <color name="widget_row_bg_neutral">#FF2A2B2E</color>
    <color name="widget_row_bg_upcoming">#FF3C2B30</color>
    <color name="widget_row_bg_ongoing">#FF1F2C3B</color>

    <!--
      通知卡片不给夜间版本，颜色只在 values/colors.xml 里定义一份。

      原因：自定义通知布局由 SystemUI 进程 inflate，它按自己的 uiMode 取资源，
      跟我们 app 的日夜设置不一定一致。之前这里有一份浅色值，
      结果在浅色卡片上取到了 values-night 的白字，整张卡发灰、几乎看不见。
      固定成一套深色字，卡片是系统画的浅底，任何 uiMode 下都可读。
    -->
</resources>
