<?xml version="1.0" encoding="utf-8"?>
<!--
  小爱 reminder_notification_small 去掉顶部 header：那行是「小爱建议」品牌条，
  第三方应用没有对应语义，且 MIUI 卡片本身已显示应用名 + 时间。
  内容区：图标 24dp + 课名 16sp 粗体 + 副标题 14.54sp，
  右侧一颗 29.1dp 高的胶囊按钮（#F0F0F0 底、圆角 15dp、13.09sp 粗体）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    android:paddingVertical="13dp">

    <RelativeLayout
        android:id="@+id/notify_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/notify_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/notify_icon_bg"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/notify_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8.72dp"
            android:layout_toEndOf="@+id/notify_icon"
            android:layout_toStartOf="@+id/notify_button_layout"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notify_title_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notify_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/notify_title"
            android:layout_marginStart="8.72dp"
            android:layout_marginTop="2.5sp"
            android:layout_toEndOf="@+id/notify_icon"
            android:layout_toStartOf="@+id/notify_button_layout"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notify_desc_text"
            android:textSize="14.54sp" />

        <FrameLayout
            android:id="@+id/notify_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="29.1dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10.55dp"
            android:background="@drawable/notify_button_bg">

            <TextView
                android:id="@+id/notify_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:maxLength="4"
                android:paddingHorizontal="14.18dp"
                android:textColor="@color/notify_button_text"
                android:textSize="13.09sp"
                android:textStyle="bold" />
        </FrameLayout>

    </RelativeLayout>

</LinearLayout>
